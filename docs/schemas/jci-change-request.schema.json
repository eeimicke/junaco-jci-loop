{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eeimicke/junaco-jci-loop/main/docs/schemas/jci-change-request.schema.json",
  "title": "JCIChangeRequest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "requestId", "idempotencyKey", "requestedAt",
    "requestedRevision", "changeType", "target",
    "requestedByRoleAssignmentId", "reason", "operations"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "requestId": {"type": "string", "format": "uuid"},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "requestedAt": {"type": "string", "format": "date-time"},
    "requestedRevision": {"type": ["integer", "null"], "minimum": 1},
    "changeType": {
      "enum": [
        "CREATED", "CHANGED", "ACHIEVED", "COMPLETED", "REPLACED",
        "REVOKED", "RESOLVED", "HISTORICAL_CORRECTION"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entityType"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "entityType": {"type": "string", "minLength": 1}
      }
    },
    "requestedByRoleAssignmentId": {"type": "string", "format": "uuid"},
    "reason": {"type": "string", "minLength": 1},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operation"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"changeType": {"const": "CREATED"}}},
      "then": {"properties": {"requestedRevision": {"type": "null"}}},
      "else": {"properties": {"requestedRevision": {"type": "integer", "minimum": 1}}}
    }
  ],
  "$defs": {
    "typedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valueType", "value"],
      "properties": {
        "valueType": {
          "enum": ["NULL", "BOOLEAN", "INTEGER", "DECIMAL", "STRING", "DATE", "DATETIME", "OBJECT", "ARRAY"]
        },
        "value": {}
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {"enum": ["ADD", "REPLACE", "REMOVE", "CONNECT", "DISCONNECT"]},
        "path": {"type": "string", "pattern": "^/"},
        "value": {"$ref": "#/$defs/typedValue"},
        "relationshipType": {"type": "string", "pattern": "^[A-Z][A-Z_]*$"},
        "direction": {"enum": ["OUTGOING", "INCOMING"]},
        "otherEntityId": {"type": "string", "format": "uuid"},
        "properties": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/typedValue"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"op": {"enum": ["CONNECT", "DISCONNECT"]}}, "required": ["op"]},
          "then": {"required": ["relationshipType", "direction", "otherEntityId"]},
          "else": {"required": ["path"]}
        },
        {
          "if": {"properties": {"op": {"enum": ["ADD", "REPLACE"]}}, "required": ["op"]},
          "then": {"required": ["value"]}
        }
      ]
    }
  }
}
