{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://eeimicke.github.io/junaco-jci-loop/ns/jci/1.0#",
    "jci": "https://eeimicke.github.io/junaco-jci-loop/ns/jci/1.0#",
    "id": "@id",
    "type": "@type",
    "entityId": "@id",
    "entityType": "@type",
    "createdAt": {"@id": "jci:createdAt", "@type": "http://www.w3.org/2001/XMLSchema#dateTime"},
    "updatedAt": {"@id": "jci:updatedAt", "@type": "http://www.w3.org/2001/XMLSchema#dateTime"},
    "validFrom": {"@id": "jci:validFrom", "@type": "http://www.w3.org/2001/XMLSchema#dateTime"},
    "validUntil": {"@id": "jci:validUntil", "@type": "http://www.w3.org/2001/XMLSchema#dateTime"},
    "revision": {"@id": "jci:revision", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "idempotencyKey": "jci:idempotencyKey",
    "targetEntityId": "jci:targetEntityId",
    "targetEntityType": {"@id": "jci:targetEntityType", "@type": "@vocab"},
    "requestedRevision": {"@id": "jci:requestedRevision", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "runId": "jci:runId",
    "bootstrapKey": "jci:bootstrapKey",
    "notCiV": "jci:notCiV",
    "selfCiV": "jci:selfCiV",
    "toServeCiV": "jci:toServeCiV",
    "evaluatedResultRevision": {"@id": "jci:evaluatedResultRevision", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "checkedCriterionRevision": {"@id": "jci:checkedCriterionRevision", "@type": "http://www.w3.org/2001/XMLSchema#integer"},
    "baseHistoryViewHash": "jci:baseHistoryViewHash",
    "HELD_BY": {"@id": "jci:HELD_BY", "@type": "@id"},
    "INFORMED_BY": {"@id": "jci:INFORMED_BY", "@type": "@id"},
    "PROTECTS": {"@id": "jci:PROTECTS", "@type": "@id"},
    "TARGETS_HISTORY": {"@id": "jci:TARGETS_HISTORY", "@type": "@id"}
  }
}
